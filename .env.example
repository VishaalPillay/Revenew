# .env — fill in your real values, never commit this file

# Claude API (Anthropic Console)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-5          # switch to claude-haiku-4-5-20251001 if you're watching the $5 credit closely

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here   # the one you set when you configured the webhook