# .env — fill in your real values, never commit this file

# LLM: Groq, not Anthropic -- SYSTEM_DESIGN.md section 3.1 names Claude, but
# this project switched providers when Anthropic billing wasn't available.
# console.groq.com/keys. GROQ_MODEL defaults to openai/gpt-oss-20b if unset --
# one of the few Groq-hosted models that honors strict:true structured output
# (see revenew/decide/generator.py). openai/gpt-oss-120b is the higher-quality,
# still-strict-capable alternative if you want to spend more per call.
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here   # the one you set when you configured the webhook